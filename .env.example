# Google AI Studio keys for Gemma 4. Comma-separated pool; rotated on 429/503.
GEMMA_API_KEYS=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Vercel Blob (required in production; local dev falls back to ./.data)
BLOB_READ_WRITE_TOKEN=

# Absolute site URL for OG/share metadata
NEXT_PUBLIC_SITE_URL=https://cheotsonnim.vercel.app

# Abuse limits (per lambda instance)
VISITS_PER_WINDOW=6
MAX_CONCURRENT_VISITS=1
